{
  "name": "oscal-scribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "demo": "tsx scripts/local-demo.ts",
    "demo:prepare": "tsx scripts/prepare-demo.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:publish": "tsx scripts/publish-content.ts",
    "build": "node scripts/generate-validator.mjs && tsc --noEmit && vite build && esbuild src/api/functions.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/api/functions.js && node scripts/package-api.mjs",
    "test": "tsx --test tests/*.test.ts && node --test tests/lens/*.cjs && node --test tests/pipelines/*.test.mjs",
    "check": "npm test && npm run build",
    "predev": "node scripts/generate-validator.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.0",
    "@azure/functions": "^4.7.0",
    "@azure/identity": "^4.11.0",
    "@azure/msal-browser": "^4.24.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "yaml": "2.8.1"
  }
}
